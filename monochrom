import numpy as np
import matplotlib.pyplot as plt
from matplotlib.colors import LinearSegmentedColormap
from PIL import Image

# 1. Завантаження входного RGB зображення (churkina.png)
pil_img = Image.open('churkina.png').convert('RGB')
img_rgb = np.array(pil_img) / 255.0  # Нормалізація у діапазон [0, 1]

# 2. Перетворення у відтінки сірого за формулою 
gray_img = 0.299 * img_rgb[:, :, 0] + 0.587 * img_rgb[:, :, 1] + 0.114 * img_rgb[:, :, 2]

# 3. Створення монохромної палітри на основі 'lightcyan'
# 'lightcyan' переходить від чорного (0.0) до lightcyan (1.0)
# Базовий колір lightcyan у системі Matplotlib
cmap_lightcyan = LinearSegmentedColormap.from_list('BlackToLightCyan', ['black', 'lightcyan'])

# 4. Візуалізація 3-х зображень та палітр поруч
fig, axes = plt.subplots(1, 3, figsize=(16, 5))

# 1. Вхідне RGB зображення
axes[0].imshow(img_rgb)
axes[0].set_title("1. Вхідне RGB (churkina.png)")
axes[0].axis('off')

# 2. Перетворене у відтінки сірого + палітра
im_gray = axes[1].imshow(gray_img, cmap='gray')
axes[1].set_title("2. Відтінки сірого (Grayscale)")
axes[1].axis('off')
cbar1 = plt.colorbar(im_gray, ax=axes[1], fraction=0.046, pad=0.04)
cbar1.set_label('Яскравість (Grayscale)')

# 3. Монохромне кольорове (lightcyan) + палітра
im_cyan = axes[2].imshow(gray_img, cmap=cmap_lightcyan)
axes[2].set_title("3. Монохромне (lightcyan)")
axes[2].axis('off')
cbar2 = plt.colorbar(im_cyan, ax=axes[2], fraction=0.046, pad=0.04)
cbar2.set_label('Мапа кольорів LightCyan')

plt.tight_layout()

# Збереження результату
plt.savefig('task_1_4_monochrome.png', bbox_inches='tight', dpi=300)
plt.show()
